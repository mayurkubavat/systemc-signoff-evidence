{"tool": "run_command", "args": "python3 -c '\nimport glob, re\nfor p in sorted(glob.glob(\"src/**/*.h\", recursive=True)):\n    with open(p) as f:\n        text = f.read()\n    idx = text.find(\"namespace uvm\")\n    if idx == -1:\n        continue\n    before = text[:idx]\n    matches = re.findall(r\"^\\s*(?:class|struct)\\s+uvm_\\w+\\s*;\", before, re.M)\n    if matches:\n        print(p, matches)\n'"}
{"tool": "run_command", "args": "python3 -c '\nimport glob, re\nfor p in sorted(glob.glob(\"src/**/*.h\", recursive=True)):\n    with open(p) as f:\n        lines = f.readlines()\n    depth = 0\n    in_uvm = False\n    uvm_depth = None\n    for i, line in enumerate(lines, 1):\n        s = line.strip()\n        if s.startswith(\"//\"):\n            continue\n        if re.match(r\"namespace\\s+uvm\\b\", s):\n            in_uvm = True\n            uvm_depth = depth\n        depth += line.count(\"{\") - line.count(\"}\")\n        if in_uvm and depth <= uvm_depth and \"}\"\u2026"}
